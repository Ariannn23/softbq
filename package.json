{
  "name": "softbq",
  "private": true,
  "version": "0.1.0",
  "description": "SOFTBQ - Convertidor local de SIRE SUNAT a formatos Contasis SQL.",
  "author": "Grupo BQ",
  "main": "electron/main.cjs",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm:dev --workspace @softbq/server\" \"npm:dev --workspace @softbq/web\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "db:push": "npm run db:push --workspace @softbq/db",
    "db:seed": "npm run db:seed --workspace @softbq/db",
    "start:electron": "electron .",
    "build:exe": "npm run build && electron-builder"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.2",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.1.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.10.0",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "fastify": "^5.3.2",
    "zod": "^3.24.3"
  },
  "build": {
    "appId": "com.grupobq.softbq",
    "productName": "SoftBQ",
    "directories": {
      "output": "C:/Users/arian/softbq-build"
    },
    "win": {
      "target": ["nsis"],
      "icon": "apps/web/public/images/icono.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "npmRebuild": false,
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "files": [
      "electron/**/*",
      "apps/server/dist/**/*",
      "apps/server/package.json",
      "apps/web/dist/**/*",
      "packages/**/dist/**/*",
      "packages/**/package.json",
      "node_modules/**/*",
      "package.json"
    ]
  }
}
